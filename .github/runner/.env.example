# Copy to `.env` and fill in. `.env` is git-ignored — never commit real tokens.

# The repo (or org) these runners attach to.
GITHUB_URL=https://github.com/copse-dev/agent-pane

# A Personal Access Token, exchanged for a short-lived registration token on
# every container start.
#   Classic PAT:      `repo` scope
#   Fine-grained PAT: repository permission "Administration" -> Read & write
ACCESS_TOKEN=

# --- Optional overrides (defaults shown) ---
# Distinct label so CI can target these instead of the macOS runners.
# RUNNER_LABELS=self-hosted,linux,docker,copse-e2e
# RUNNER_GROUP=default
# EPHEMERAL=true
