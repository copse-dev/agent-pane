{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node ../scripts/hook-file-check.mts --dialect copse --fix",
        "glob": [
          "src/**/*.{ts,mts,tsx,css,html}",
          "packages/*/src/**/*.ts",
          "scripts/**/*.{ts,mts}",
          "tests/**/*.ts"
        ],
        "onFailure": "open",
        "timeout": 60
      },
      {
        "command": "node ../scripts/hook-file-check.mts --dialect copse",
        "glob": [
          "src/**/*.{ts,mts,tsx}",
          "packages/*/src/**/*.ts",
          "scripts/**/*.{ts,mts}",
          "tests/**/*.ts"
        ],
        "async": true,
        "onFailure": "open",
        "timeout": 60
      }
    ]
  }
}
