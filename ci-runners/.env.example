# Copy to `.env` and fill in. `.env` is git-ignored — never commit real tokens.

# --- Runtime: where the runners attach ------------------------------------
# A REPO url  (https://github.com/<owner>/<repo>) registers a repo-level fleet.
# An ORG url  (https://github.com/<owner>) registers an ORG-shared pool that
# every repo in the runner group can use — this is the point of consolidation.
GITHUB_URL=https://github.com/copse-dev

# PAT exchanged for a short-lived registration token on every container start.
#   repo scope: classic `repo`, or fine-grained repository Administration R/W.
#   org  scope: classic `admin:org`, or fine-grained
#               organization "Self-hosted runners" -> Read & write.
ACCESS_TOKEN=

# --- Build time: prefetching package inputs ("thread in main") ------------
# Which consumer repo's lockfile to prefetch for a warm start, and at which ref.
TARGET_REPO=copse-dev/agent-pane
TARGET_REF=main

# Read token used ONLY during `docker build` to clone TARGET_REPO and let its
# pnpm fetch read the PRIVATE @copse/streaming-markdown git dependency. Needs
# Contents: Read on BOTH copse-dev/agent-pane AND copse-dev/streaming-markdown.
#   classic `repo`, or a fine-grained token scoped to both repos (Contents: Read).
# Kept out of the image (BuildKit secret). Leave empty to skip prefetching
# (runners then restore package inputs in the setup action).
BUILD_GH_TOKEN=

# --- Optional overrides (defaults shown) ----------------------------------
# Unified label set — serves both tiers. Drop one to dedicate a box to a tier.
# RUNNER_LABELS=self-hosted,linux,docker,copse-e2e,copse-checks
# RUNNER_GROUP=default
# EPHEMERAL=true  # required; persistent multi-job runners are rejected
