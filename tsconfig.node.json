{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "ESNext"],
    "outDir": "dist-types/node",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@copse/agent": ["./packages/agent/src/index.ts"],
      "@copse/agent/*": ["./packages/agent/src/*"],
      "@copse/llm": ["./packages/llm/src/index.ts"],
      "@copse/llm/*": ["./packages/llm/src/*"],
      "@copse/plan-usage": ["./packages/plan-usage/src/index.ts"],
      "@copse/plan-usage/*": ["./packages/plan-usage/src/*"]
    },
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noPropertyAccessFromIndexSignature": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "scripts/**/*",
    "packages/agent/src/**/*",
    "packages/llm/src/**/*",
    "packages/plan-usage/src/**/*"
  ]
}
