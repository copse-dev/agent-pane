+/**
+ * PATCH (copse-dev/agent-pane): memoize the realpath lookups below for the
+ * duration of one synchronous sandbox-profile build.
+ *
+ * `generateSandboxProfile` pushes every read/write/deny path entry through
+ * `normalizePathForSandbox`, one blocking `realpathSync` apiece. A Copse
+ * workspace overlay produces ~49 entries per command, and ~35% of them resolve
+ * a directory another entry already resolved -- `<dir>` and `<dir>/**` are two
+ * entries naming one directory. A DevTools trace of an Electron host measured
+ * 2.94ms per profile build, once per sandboxed command, ~10 times a second.
+ *
+ * The memo is scoped to a single build rather than shared across commands. A
+ * profile is generated synchronously, so clearing on the next microtask means
+ * every entry sharing a memo belongs to one build and no resolution is ever
+ * reused by a later command. These paths become seatbelt/bwrap rules, so a
+ * resolution that outlived its build could emit a rule naming a stale symlink
+ * target; this scoping makes that impossible while still removing the
+ * duplicates. Failures are memoized too, so a missing path costs one syscall
+ * per build like any other.
+ */
+let realpathBuildMemo = null;
+function realpathSyncForBuild(target) {
+    if (realpathBuildMemo === null) {
+        realpathBuildMemo = new Map();
+        queueMicrotask(() => {
+            realpathBuildMemo = null;
+        });
+    }
+    if (realpathBuildMemo.has(target)) {
+        const cached = realpathBuildMemo.get(target);
+        if (cached instanceof Error)
+            throw cached;
+        return cached;
+    }
+    try {
+        const resolved = fs.realpathSync(target);
+        realpathBuildMemo.set(target, resolved);
+        return resolved;
+    }
+    catch (error) {
+        realpathBuildMemo.set(target, error);
+        throw error;
+    }
