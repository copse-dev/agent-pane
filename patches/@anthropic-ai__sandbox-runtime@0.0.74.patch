+function realpathSyncForBuild(target) {
+    if (realpathBuildMemo === null) {
+        realpathBuildMemo = new Map();
+        queueMicrotask(() => {
+            realpathBuildMemo = null;
+        });
+    }
+    if (realpathBuildMemo.has(target)) {
+        const cached = realpathBuildMemo.get(target);
+        if (cached instanceof Error)
+            throw cached;
+        return cached;
+    }
+    try {
+        const resolved = fs.realpathSync(target);
+        realpathBuildMemo.set(target, resolved);
+        return resolved;
+    }
+    catch (error) {
+        realpathBuildMemo.set(target, error);
+        throw error;
+    }
