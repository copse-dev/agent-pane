diff --git a/build/utils/request-cancellation.js b/build/utils/request-cancellation.js
new file mode 100644
--- /dev/null
+++ b/build/utils/request-cancellation.js
@@ -0,0 +1,21 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+export const requestSignalStorage = new AsyncLocalStorage();
+export function bindRequestProcess(child, signal) {
+  if (!signal) return;
+  const terminate = (killSignal) => {
+    try {
+      if (process.platform !== "win32" && child.pid) process.kill(-child.pid, killSignal);
+      else child.kill(killSignal);
+    } catch (error) {
+      if (error.code !== "ESRCH") throw error;
+    }
+  };
+  const abort = () => {
+    terminate("SIGTERM");
+    const timer = setTimeout(() => terminate("SIGKILL"), 500);
+    timer.unref();
+  };
+  signal.addEventListener("abort", abort, { once: true });
+  if (signal.aborted) abort();
+  child.once("close", () => signal.removeEventListener("abort", abort));
+}
