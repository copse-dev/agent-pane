<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Electron runs a V8 JIT, so the hardened runtime must permit JIT-mapped
         and unsigned executable memory or the renderer/main crash on launch. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Packaged native addons are signed with the app. Keep library validation
         and DYLD environment protections enabled in the trusted main process. -->
</dict>
</plist>
