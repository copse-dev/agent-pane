# Default isolated linker: top-level deps are symlinks into node_modules/.pnpm.
# Clone (APFS copy-on-write) from the content-addressable store so worktrees share
# package bytes. Post-install artifacts (electron/dist, node-pty rebuild) are
# handled separately — see scripts/patch-dev-name.mts.
package-import-method=clone
# Override user-level ignore-scripts=true so postinstall (node-pty rebuild, gortex) runs.
ignore-scripts=false
# Non-interactive installs (CI / agent shells without a TTY).
confirmModulesPurge=false
