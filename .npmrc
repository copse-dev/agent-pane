# Default isolated linker: top-level deps are symlinks into node_modules/.pnpm.
# auto: prefer APFS/Btrfs clone from the store, then hardlink, then copy.
# Forced `clone` fails with ENOTSUP on Linux CI filesystems that lack clonefile.
# Post-install artifacts (electron/dist, node-pty rebuild) are handled separately
# — see scripts/patch-dev-name.mts.
package-import-method=auto
# Override user-level ignore-scripts=true so postinstall (node-pty rebuild, gortex) runs.
ignore-scripts=false
# Non-interactive installs (CI / agent shells without a TTY).
confirmModulesPurge=false
