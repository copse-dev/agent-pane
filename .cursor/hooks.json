{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node ../scripts/hook-file-check.mts --dialect cursor",
        "glob": [
          "src/**/*.{ts,mts,tsx,css,html}",
          "packages/*/src/**/*.ts",
          "scripts/**/*.{ts,mts}",
          "tests/**/*.ts"
        ]
      }
    ]
  }
}
