# syntax=docker/dockerfile:1

FROM docker:29.6.2-cli AS docker-cli

FROM node:22.23.1-bookworm-slim

ARG SKILLSBENCH_REVISION=b63b7b2850226b6aa4fb5929a8c1ac7bc4d9a6af
ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/copse/.venv/bin:$PATH \
    UV_NO_PROGRESS=1 \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    COPSE_SKILLSBENCH_AGENT_BUNDLE=/opt/copse/prebuilt/skillsbench-agent.cjs

RUN apt-get update \
    && apt-get install -y --no-install-recommends awscli ca-certificates git python3 python3-pip tar \
    && pip3 install --break-system-packages --no-cache-dir uv==0.11.30 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins

RUN uv python install 3.12.12 \
    && uv venv /opt/copse/.venv --python 3.12.12 \
    && uv pip install --python /opt/copse/.venv/bin/python benchflow==0.6.3

RUN git clone --filter=blob:none --no-checkout https://github.com/benchflow-ai/skillsbench.git /opt/skillsbench \
    && git -C /opt/skillsbench fetch --depth 1 origin "$SKILLSBENCH_REVISION" \
    && git -C /opt/skillsbench checkout --detach "$SKILLSBENCH_REVISION" \
    && test "$(git -C /opt/skillsbench rev-parse HEAD)" = "$SKILLSBENCH_REVISION"

WORKDIR /opt/copse
COPY benchmarks/terminal_bench/worker/package.json benchmarks/terminal_bench/worker/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

COPY benchmarks ./benchmarks
COPY packages ./packages
COPY scripts ./scripts
COPY src/shared ./src/shared
RUN mkdir -p prebuilt \
    && node scripts/build-skillsbench-agent.mts "$COPSE_SKILLSBENCH_AGENT_BUNDLE" \
    && chmod 755 benchmarks/skillsbench/run-shard.sh benchmarks/skillsbench/run_spike.py

ENTRYPOINT ["/opt/copse/benchmarks/skillsbench/run-shard.sh"]
