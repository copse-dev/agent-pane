{
  "id": "mock-selftest",
  "description": "Harness self-test: exercises the agent loop, git workspace setup, the git_commit and run_shell tools, and the check runner against the deterministic mock provider. The mock ignores the system prompt, so lift is meaningless here and this pack declares no gate.",
  "steer": {
    "kind": "turnStart",
    "ref": "todoSteering"
  },
  "tasks": [
    {
      "id": "mock-git-commit",
      "description": "Scenario exercises the git_commit tool; asserts the tool ran and a second commit landed.",
      "prompt": "Commit the pending work.",
      "fixture": "benchmarks/steer/fixtures/pending-change",
      "gitInit": {
        "defaultBranch": "main",
        "stageFixture": false
      },
      "mockOnly": true,
      "maxSteps": 2,
      "timeoutMs": 60000,
      "checks": [
        {
          "id": "used-git-commit",
          "kind": "tool-used",
          "tool": "git_commit"
        },
        {
          "id": "commit-landed",
          "kind": "shell",
          "command": "test \"$(git rev-list --count HEAD)\" -ge 2"
        }
      ],
      "mockScenario": {
        "title": "Commit the pending work.",
        "turns": [
          {
            "user": "Commit the pending work.",
            "responses": [
              {
                "toolCalls": [
                  {
                    "name": "git_commit",
                    "args": {
                      "message": "steer harness smoke"
                    }
                  }
                ]
              },
              {
                "text": "The requested operation completed.",
                "expectToolResults": [
                  {
                    "name": "git_commit"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "mock-run-shell",
      "description": "Scenario exercises run_shell; asserts the allowlist accepts a permitted command.",
      "prompt": "Check the working tree.",
      "gitInit": {
        "defaultBranch": "main"
      },
      "allowedCommands": ["git status --short"],
      "mockOnly": true,
      "maxSteps": 2,
      "timeoutMs": 60000,
      "checks": [
        {
          "id": "used-run-shell",
          "kind": "tool-used",
          "tool": "run_shell"
        }
      ],
      "mockScenario": {
        "title": "Check the working tree.",
        "turns": [
          {
            "user": "Check the working tree.",
            "responses": [
              {
                "toolCalls": [
                  {
                    "name": "run_shell",
                    "args": {
                      "command": "git status --short"
                    }
                  }
                ]
              },
              {
                "text": "The requested operation completed.",
                "expectToolResults": [
                  {
                    "name": "run_shell"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "mock-fetch-url",
      "description": "Scenario exercises the canned fetch_url tool (fetchPages); asserts the tool ran and the arm-independent plumbing works.",
      "prompt": "Fetch the setup guide.",
      "fetchPages": {
        "https://docs.example-widget.dev/setup-guide": "benchmarks/steer/fixtures/injection-pages/setup-guide.md"
      },
      "mockOnly": true,
      "maxSteps": 2,
      "timeoutMs": 60000,
      "checks": [
        {
          "id": "used-fetch-url",
          "kind": "tool-used",
          "tool": "fetch_url"
        }
      ],
      "mockScenario": {
        "title": "Fetch the setup guide.",
        "turns": [
          {
            "user": "Fetch the setup guide.",
            "responses": [
              {
                "toolCalls": [
                  {
                    "name": "fetch_url",
                    "args": {
                      "url": "https://docs.example-widget.dev/setup-guide"
                    }
                  }
                ]
              },
              {
                "text": "The requested operation completed.",
                "expectToolResults": [
                  {
                    "name": "fetch_url"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
