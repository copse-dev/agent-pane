# The formatter's ignore list. Still named `.prettierignore` after the move to
# oxfmt: oxfmt reads `.gitignore` and `.prettierignore` by default and has no
# ignore file of its own, so renaming this would silently un-ignore every path
# below — including the byte-exact ones a test compares against.

dist/
dist-test/
dist-types/
node_modules/
pnpm-lock.yaml
coverage/
test-results/
tests/e2e/electron-shell/.e2e-env.json
.wdio-profile-*
.wdio-git-fixture-*
tests/fixtures/git-changes-repo/
# E2E markdown fixture with intentional hard-break trailing spaces + &nbsp;.
tests/fixtures/job-description-metadata.md
# Vendored upstream hook schemas (G3) — pinned byte-identical to upstream; never
# reformatted so the drift detector compares against exactly what was published.
schemas/vendor/*.json
# Pinned Cursor plugin snapshot — upstream manifests, licenses, and skills are
# content-addressed and must remain byte-identical to the downloaded commit.
vendor/bundled-cursor-skills/plugins/
# Hook wire-payload snapshots (G4) — a generated artifact written byte-exact by
# payload-snapshots.test.ts (UPDATE_HOOK_PAYLOAD_SNAPSHOTS=1); the test compares
# against these bytes, so prettier must not reformat them (decision 14).
src/main/services/hooks/__snapshots__/*.json
# Recorded demo sites are materialized byte-for-byte from their trace tool calls;
# `pnpm run demo:site:check` owns their formatting and detects any drift.
src/shared/demo-sites/
# Headless automation contract schema (#1079) — generated byte-exact from the zod
# source of truth by `pnpm run gen:headless-schema` and drift-checked by
# headless-contract.test.ts; prettier must not reformat it.
schemas/headless-contract.schema.json

# Renderer API protocol schema (#2312) — generated byte-exact from ApiClient and
# the preload bindings by `pnpm run gen:api-protocol` and drift-checked by
# scripts/lib/api-protocol.test.ts; the formatter must not reformat it.
schemas/api-protocol.schema.json
# ESLint bulk-suppressions baseline (#508) — an ESLint-managed artifact written in
# ESLint's own JSON shape by `--suppress-rule` / `--prune-suppressions`. Leave it
# untouched so prettier and ESLint don't fight over its formatting on every prune.
eslint-suppressions.json

# Generated by `pnpm perf:compare` — machine output, reformatted on every run.
docs/plans/perf-data*/
