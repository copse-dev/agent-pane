ARG NODE_VERSION=24.22.1
FROM node:${NODE_VERSION}-trixie-slim

ARG PNPM_VERSION=10.34.5
ENV DEBIAN_FRONTEND=noninteractive \
    npm_config_update_notifier=false

# This image runs only brokered validation commands. Dependencies arrive from
# the host's read-only, exact-lockfile pnpm store; the runtime itself has no
# network interface. Keep the toolchain broad enough for Copse's focused unit
# tests without carrying an agent, provider credential, or forge client.
RUN --mount=type=secret,id=proxy_ca apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      cargo \
      g++ \
      git \
      make \
      pkg-config \
      python3 \
      ripgrep \
      socat \
    && rm -rf /var/lib/apt/lists/* \
    && if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi \
    && npm install -g --no-audit --no-fund "pnpm@${PNPM_VERSION}" \
    && npm cache clean --force

# Apple container has no no-new-privileges flag, so its review cells run every
# command under `setpriv --no-new-privs` (util-linux). Fail the build rather
# than produce an image whose cells could not set it, and strip every setuid
# and setgid bit so there is nothing to escalate through under either engine.
RUN command -v setpriv >/dev/null \
    && find / -xdev -type f -perm /6000 -exec chmod ug-s {} + \
    && test -z "$(find / -xdev -type f -perm /6000 -print -quit)"

WORKDIR /workspace
