#!/bin/sh
# Stand-in for the OpenSSH client in e2e specs that need a reachable SSH host.
#
# The app runs the system `ssh` for every remote operation, so a spec puts this
# directory first on the app's PATH (tests/e2e/helpers/fake-ssh.ts) and the
# "remote host" becomes this machine: the remote command line, which OpenSSH
# receives as its last argument, runs in a local shell. No product code knows
# this exists.
#
# State lives in $COPSE_E2E_FAKE_SSH_STATE:
#   master     present while the control master is "up"
#   host-down  present while the host is unreachable; a spec creates and
#              removes it to drop and restore the link
#   home       if present, the remote account's home directory (its contents
#              are the path); otherwise the local $HOME is reported
state="${COPSE_E2E_FAKE_SSH_STATE:?fake ssh needs COPSE_E2E_FAKE_SSH_STATE}"

# Control commands talk to the local master only; they never reach the host.
case " $* " in
  *" -O check "*)
    [ -e "$state/master" ] && [ ! -e "$state/host-down" ] && exit 0
    exit 255
    ;;
  *" -O exit "*)
    rm -f "$state/master"
    exit 0
    ;;
  *" -O forward "* | *" -O cancel "*)
    # A unix socket forward (`-L local.sock:remote.sock`) joins two paths on
    # this one machine: a small relay listens on the local one, as OpenSSH's
    # does, until it is cancelled. A TCP forward needs nothing.
    action=
    spec=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -O) action="$2" ;;
        -L) spec="$2" ;;
      esac
      shift
    done
    case "$spec" in
      /*:/*)
        local_socket="${spec%%:*}"
        relay="$state/relay-$(printf %s "$local_socket" | cksum | cut -d' ' -f1)"
        [ -e "$relay" ] && kill "$(cat "$relay")" 2>/dev/null
        rm -f "$relay" "$local_socket"
        if [ "$action" = forward ]; then
          node -e '
            const net = require("net")
            const [local, remote] = process.argv.slice(1)
            net.createServer((client) => {
              const host = net.connect(remote)
              client.pipe(host).on("error", () => host.destroy())
              host.pipe(client).on("error", () => client.destroy())
              client.on("error", () => host.destroy())
              host.on("error", () => client.destroy())
            }).listen(local)
          ' "$local_socket" "${spec#*:}" </dev/null >/dev/null 2>&1 &
          echo "$!" >"$relay"
          tries=0
          while [ ! -S "$local_socket" ] && [ "$tries" -lt 100 ]; do
            tries=$((tries + 1))
            sleep 0.05
          done
        fi
        ;;
    esac
    exit 0
    ;;
esac

if [ -e "$state/host-down" ]; then
  rm -f "$state/master"
  echo "ssh: connect to host dev.example port 22: Connection refused" >&2
  exit 255
fi

# Starting the master, or any command (ControlMaster=auto), brings the link up.
: >"$state/master"
case " $* " in
  *" -fNM "*) exit 0 ;;
esac

for remote_command; do :; done

# Report the same tools on every runner, so a capability banner never depends
# on what the CI image happens to have installed.
case "$remote_command" in
  "command -v "*)
    echo "/usr/bin/${remote_command#command -v }"
    exit 0
    ;;
esac

if [ -e "$state/home" ]; then
  HOME="$(cat "$state/home")"
  export HOME
fi
exec /bin/sh -c "$remote_command"
