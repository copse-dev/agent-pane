diff --git a/tests/e2e/helpers/composer-diagnostic.ts b/tests/e2e/helpers/composer-diagnostic.ts
new file mode 100644
index 000000000..bc20da406
--- /dev/null
+++ b/tests/e2e/helpers/composer-diagnostic.ts
@@ -0,0 +1,186 @@
+import { mkdirSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { browser } from '@wdio/globals'
+
+declare global {
+  interface Window {
+    __composerDiagnostic?: {
+      rows: Record<string, unknown>[]
+      sample: (kind: string, detail?: unknown) => void
+      stop: () => void
+    }
+  }
+}
+
+// Isolated diagnostic only. Reads layout and records producer marks; never
+// writes layout, reserve, scroll position, animation state, or capture settings.
+export async function startComposerDiagnostic(): Promise<void> {
+  await browser.execute(() => {
+    const initialTargets = {
+      composer: document.getElementById('input-bar'),
+      pane: document.getElementById('pane-chat'),
+      conversation: document.getElementById('conversation'),
+      transcript: document.querySelector('.messages-list'),
+      result: document.querySelector('[data-message-id="msg-assistant-result"]'),
+    }
+    const rows: Record<string, unknown>[] = []
+    const rect = (element: Element | null): Record<string, number> | null => {
+      if (!element) return null
+      const r = element.getBoundingClientRect()
+      return {
+        x: r.x,
+        y: r.y,
+        width: r.width,
+        height: r.height,
+        top: r.top,
+        bottom: r.bottom,
+        left: r.left,
+        right: r.right,
+      }
+    }
+    const sample = (kind: string, detail?: unknown): void => {
+      const input = document.getElementById('input-bar')
+      const pane = document.getElementById('pane-chat')
+      const conversation = document.getElementById('conversation')
+      const list = document.querySelector<HTMLElement>('.messages-list')
+      const result = document.querySelector('[data-message-id="msg-assistant-result"]')
+      rows.push({
+        t: performance.now(),
+        kind,
+        detail,
+        targetsUnchanged: {
+          composer: input !== null && input === initialTargets.composer,
+          pane: pane !== null && pane === initialTargets.pane,
+          conversation: conversation !== null && conversation === initialTargets.conversation,
+          transcript: list !== null && list === initialTargets.transcript,
+          result: result !== null && result === initialTargets.result,
+        },
+        dpr: devicePixelRatio,
+        viewport: { width: innerWidth, height: innerHeight },
+        composer: {
+          rect: rect(input),
+          clientWidth: input?.clientWidth,
+          clientHeight: input?.clientHeight,
+          borderTop: input ? getComputedStyle(input).borderTopWidth : null,
+          borderBottom: input ? getComputedStyle(input).borderBottomWidth : null,
+        },
+        reserve: pane ? getComputedStyle(pane).getPropertyValue('--chat-composer-height') : null,
+        conversation: {
+          rect: rect(conversation),
+          paddingBottom: conversation ? getComputedStyle(conversation).paddingBottom : null,
+        },
+        transcript: {
+          rect: rect(list),
+          clientHeight: list?.clientHeight,
+          scrollHeight: list?.scrollHeight,
+          scrollTop: list?.scrollTop,
+          bottomGap: list ? list.scrollHeight - list.clientHeight - list.scrollTop : null,
+          stickyBand: list ? getComputedStyle(list).getPropertyValue('--sticky-prompt-band') : null,
+          stickyScrollBand: list
+            ? getComputedStyle(list).getPropertyValue('--sticky-prompt-scroll-band')
+            : null,
+        },
+        result: rect(result),
+        resultHeading: rect(result?.querySelector('h1,h2,h3,h4') ?? null),
+      })
+    }
+    const collect = (entries: PerformanceEntry[]): void => {
+      for (const entry of entries) {
+        if (entry instanceof PerformanceMark && entry.name.startsWith('copse-diag-')) {
+          // Explicit detail retention: PerformanceEntry.toJSON drops this field.
+          sample(`producer:${entry.name}`, { producerTime: entry.startTime, detail: entry.detail })
+        }
+      }
+    }
+    const marks = new PerformanceObserver((list) => collect(list.getEntries()))
+    marks.observe({ type: 'mark', buffered: true })
+    const mutations = new MutationObserver((entries) =>
+      sample(
+        'mutation',
+        entries.map((m) => ({
+          type: m.type,
+          target:
+            m.target instanceof Element
+              ? { tag: m.target.tagName, id: m.target.id, class: m.target.className }
+              : { nodeType: m.target.nodeType },
+          attribute: m.attributeName,
+        })),
+      ),
+    )
+    mutations.observe(document.documentElement, {
+      attributes: true,
+      childList: true,
+      characterData: true,
+      subtree: true,
+    })
+    const resize = new ResizeObserver((entries) =>
+      sample(
+        'resize-observer',
+        entries.map((e) => ({
+          id: e.target.id,
+          class: e.target.className,
+          content: { width: e.contentRect.width, height: e.contentRect.height },
+          border: Array.from(e.borderBoxSize, (s) => ({
+            inlineSize: s.inlineSize,
+            blockSize: s.blockSize,
+          })),
+        })),
+      ),
+    )
+    for (const element of [
+      document.getElementById('input-bar'),
+      document.getElementById('conversation'),
+      document.querySelector('.messages-list'),
+      document.querySelector('[data-message-id="msg-assistant-result"]'),
+    ]) {
+      if (element) resize.observe(element, { box: 'border-box' })
+    }
+    const scroll = (event: Event): void =>
+      sample('scroll-event', {
+        trusted: event.isTrusted,
+        target:
+          event.target instanceof Element
+            ? { id: event.target.id, class: event.target.className }
+            : null,
+      })
+    document.addEventListener('scroll', scroll, { capture: true, passive: true })
+    let frame = 0
+    const tick = (): void => {
+      sample('raf')
+      frame = requestAnimationFrame(tick)
+    }
+    frame = requestAnimationFrame(tick)
+    window.__composerDiagnostic = {
+      rows,
+      sample,
+      stop: () => {
+        cancelAnimationFrame(frame)
+        collect(marks.takeRecords())
+        marks.disconnect()
+        mutations.disconnect()
+        resize.disconnect()
+        document.removeEventListener('scroll', scroll, true)
+      },
+    }
+    sample('trace-start', { userAgent: navigator.userAgent, timeOrigin: performance.timeOrigin })
+  })
+}
+
+export async function sampleComposerDiagnostic(kind: string): Promise<void> {
+  await browser.execute((label) => window.__composerDiagnostic?.sample(label), kind)
+}
+
+export async function stopComposerDiagnostic(): Promise<Record<string, unknown>[]> {
+  return browser.execute(() => {
+    window.__composerDiagnostic?.sample('trace-stop')
+    window.__composerDiagnostic?.stop()
+    return window.__composerDiagnostic?.rows ?? []
+  })
+}
+
+let captureOrdinal = 0
+export function retainComposerCapture(filename: string, bytes: Uint8Array): void {
+  const directory = join(process.cwd(), '.tmp/composer-observer/png-attempts')
+  mkdirSync(directory, { recursive: true })
+  writeFileSync(join(directory, `${String(++captureOrdinal)}-${filename}`), bytes)
+}
