{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copse.dev/schemas/copse-plan.schema.json",
  "title": "Copse Plan Mode artifacts",
  "description": "On-disk Plan Mode records under a thread directory (plans/<planId>/). Source of truth for runtime validation is the zod schemas in src/shared/threads/plan-schema.ts; this file mirrors them for docs and external tooling. See docs/plans/plan-mode-and-rewind.md (#1080 P1) and docs/thread-store-format.md.",
  "$defs": {
    "planStatus": {
      "type": "string",
      "enum": ["draft", "approved", "superseded", "abandoned"]
    },
    "planMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "threadId",
        "title",
        "status",
        "currentRevision",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "planId": { "type": "string", "minLength": 1 },
        "threadId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/planStatus" },
        "currentRevision": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "approvedAt": { "type": "integer" },
        "approvedRevision": { "type": "integer", "minimum": 1 },
        "executionProfileId": { "type": "string", "minLength": 1 },
        "contentHash": {
          "type": "string",
          "minLength": 1,
          "description": "Hex sha256 of the approved revision body."
        }
      }
    },
    "planComment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "body", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "body": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "integer" },
        "author": { "type": "string", "enum": ["user", "agent"] },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "planCommentsFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comments"],
      "properties": {
        "comments": {
          "type": "array",
          "items": { "$ref": "#/$defs/planComment" }
        }
      }
    },
    "planApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "approvedRevision", "approvedAt", "executionProfileId", "contentHash"],
      "properties": {
        "planId": { "type": "string", "minLength": 1 },
        "approvedRevision": { "type": "integer", "minimum": 1 },
        "approvedAt": { "type": "integer" },
        "executionProfileId": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/planMeta" },
    { "$ref": "#/$defs/planCommentsFile" },
    { "$ref": "#/$defs/planApproval" }
  ]
}
