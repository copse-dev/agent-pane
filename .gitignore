assets/icons/**/app.iconset/
vendor/gortex/
vendor/bundled-cursor-skills/
.tmp/
.DS_Store
*.log

__pycache__/

# Test artifacts
test-results/
bench-results/
# Generated by scripts/fetch-swe-bench-subset.mts (pin list is committed)
benchmarks/tasks/swe-bench/
.wdio-profile-*/
.wdio-git-fixture-*/
tests/fixtures/git-changes-repo/.git/
# Created inside the fixture's own repo, on its branch — tracking it here would
# put the file in the fixture's baseline commit, leaving the branch with nothing
# committed for the Changes panel to list.
tests/fixtures/git-changes-repo/committed.ts
.wdio-eval-profile-*/
.wdio-eval-userdata-*/
.wdio-eval-chrome-*/
tests/e2e/electron-shell/.eval-env.json
tests/e2e/artifacts/
e2e-failure-artifacts/

# Internal build/dev notes — not published for now
DEVELOPMENT-NOTES.md

# Local env / secrets
.env
.env.*

# MCP server config may hold secrets / be machine-specific (keep the .example)
mcp.json
.cursor/mcp.json
.mcp.json

# Claude Code local agent worktrees (linked checkouts)
.claude/worktrees/
dist-test-iso/

# Generated by `npm run probe:acp` — machine/version-specific ACP support matrix.
# Force-add (git add -f) if you want to commit a reference snapshot.
docs/acp-support-matrix.md
docs/acp-support-matrix.json
docs/acp-behavior-matrix.md
docs/acp-behavior-matrix.json

# The site's Markdown twins, generated from site/*.html by
# scripts/sync-site-markdown.mts. pages.yml regenerates them into the deployed
# tree, so the published copy is always what the published HTML says. Committing
# them would put a second copy of every page in the repo whose only job is to be
# kept in step with the first. `pnpm run site:md` writes them here for local
# preview; the deploy never reads what it finds.
/site/*.md
/site/llms.txt
