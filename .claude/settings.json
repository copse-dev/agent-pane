{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hook-file-check.mts\" --dialect claude --fix",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
