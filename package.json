{
  "name": "copse-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Copse — AI coding assistant desktop app",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.mts",
    "build": "node --experimental-strip-types scripts/build.mts",
    "generate:icon": "node --experimental-strip-types scripts/generate-icon.mts",
    "icons:mac": "node --experimental-strip-types scripts/generate-icon.mts && COPSE_PANEL_REFRESH_DOCK=1 node --experimental-strip-types scripts/patch-dev-name.mts",
    "start:mac": "npm run icons:mac && env -u ELECTRON_RUN_AS_NODE electron dist/main/index.js",
    "start": "electron dist/main/index.js",
    "postinstall": "node --experimental-strip-types scripts/patch-dev-name.mts && node --experimental-strip-types scripts/postinstall-native.mts && node --experimental-strip-types scripts/fetch-codesearch.mts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types scripts/run-tests.mts",
    "validate:local-agent": "node --experimental-strip-types scripts/run-validate-local-agent.mts",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:e2e:ci": "wdio run wdio.conf.ts --spec tests/e2e/tool-display.e2e.ts",
    "test:e2e:agent-eval": "wdio run wdio.eval.conf.ts",
    "test:e2e:markdown": "wdio run wdio.conf.ts --spec tests/e2e/markdown-list-indent.e2e.ts --spec tests/e2e/markdown-ordered-list-spacing.e2e.ts --spec tests/e2e/semantic-search-markdown.e2e.ts",
    "analyze:thread": "node --experimental-strip-types scripts/run-analyze-thread.mts",
    "sync:models": "node --experimental-strip-types scripts/sync-model-catalog.mts",
    "pack:mac": "npm run build && npm run icons:mac && electron-builder --mac dir",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "build": {
    "appId": "app.copse-panel",
    "productName": "Copse",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**/*",
      "**/node_modules/@anthropic-ai/sandbox-runtime/**/*"
    ],
    "mac": {
      "icon": "assets/icons/app.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.56",
    "@mozilla/readability": "^0.6.0",
    "@anthropic-ai/sdk": "^0.104.2",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "duck-duck-scrape": "^2.2.7",
    "electron-store": "^10.0.1",
    "jsdom": "^29.1.1",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.15.0",
    "micromatch": "^4.0.8",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "openai": "^6.42.0",
    "shell-quote": "^1.8.4",
    "tldts": "^7.4.3",
    "turndown": "^7.2.0",
    "vscode-material-icons": "^0.1.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/micromatch": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/shell-quote": "^1.7.5",
    "@types/turndown": "^5.0.5",
    "@wdio/cli": "^9.29.0",
    "@wdio/local-runner": "^9.29.0",
    "@wdio/mocha-framework": "^9.29.0",
    "@wdio/spec-reporter": "^9.29.0",
    "c8": "^11.0.0",
    "electron": "^35.5.0",
    "electron-builder": "^26.15.3",
    "electron-chromedriver": "^35.7.5",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.5",
    "expect-webdriverio": "^5.6.8",
    "fast-check": "^4.1.1",
    "happy-dom": "^17.4.7",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "webdriverio": "^9.29.0"
  },
  "engines": {
    "node": ">=22"
  }
}
