{
  "name": "agent-pane",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-powered coding assistant desktop app",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.mts",
    "build": "node --experimental-strip-types scripts/build.mts",
    "start": "electron dist/main/index.js",
    "postinstall": "node --experimental-strip-types scripts/patch-dev-name.mts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types scripts/run-tests.mts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.56",
    "@anthropic-ai/sdk": "^0.52.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "electron-store": "^10.0.1",
    "micromatch": "^4.0.8",
    "monaco-editor": "^0.52.2",
    "openai": "^4.104.0",
    "shell-quote": "^1.8.4",
    "vscode-material-icons": "^0.1.1",
    "zod": "^3.25.36",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/shell-quote": "^1.7.5",
    "c8": "^10.1.3",
    "electron": "^35.5.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "fast-check": "^4.1.1",
    "happy-dom": "^17.4.7",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "engines": {
    "node": ">=22"
  }
}
