{
  "name": "copse-panel",
  "version": "0.1.0-beta.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Copse \u2014 AI coding assistant desktop app",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.mts",
    "oracle": "node scripts/test-oracle.mts",
    "check:oracle": "node scripts/check-oracle.mts",
    "check:screenshots": "node scripts/check-screenshots.mts",
    "filter:screenshots": "node scripts/filter-screenshots.mts",
    "build": "node scripts/build.mts",
    "build:demo": "node scripts/build.mts --demo",
    "build:release": "COPSE_RELEASE=1 node scripts/build.mts",
    "generate:icon": "node scripts/generate-icon.mts",
    "detect:acp": "node scripts/detect-acp-agents.mts",
    "probe:acp": "node scripts/run-probe-acp-agents.mts",
    "probe:acp:behavior": "node scripts/run-probe-acp-behavior.mts",
    "probe:plan-usage": "node scripts/probe-plan-usage.mts",
    "icons:mac": "node scripts/generate-icon.mts && COPSE_PANEL_REFRESH_DOCK=1 node scripts/patch-dev-name.mts",
    "start:mac": "npm run icons:mac && env -u ELECTRON_RUN_AS_NODE electron dist/main/index.js",
    "prestart": "node scripts/patch-dev-name.mts",
    "start": "electron dist/main/index.js",
    "preinstall": "node scripts/check-node-version.cjs",
    "postinstall": "node scripts/check-node-version.cjs && node scripts/patch-dev-name.mts && node scripts/postinstall-native.mts && node scripts/fetch-gortex.mts && node scripts/fetch-bundled-cursor-skills.mts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "check:dead-code": "node scripts/check-dead-code.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-tests.mts",
    "coverage": "node scripts/run-tests.mts --bundle-only && c8 node scripts/run-tests.mts --test-only",
    "coverage:check": "node scripts/coverage-gate.mts",
    "coverage:update": "node scripts/coverage-gate.mts --update",
    "coverage:ci": "npm run coverage && npm run coverage:check",
    "bench:thread-store": "node scripts/bench-thread-store.mts",
    "validate:local-agent": "node scripts/run-validate-local-agent.mts",
    "bench:agent": "node scripts/run-bench-agent.mts",
    "bench:terminal": "node scripts/run-terminal-bench.mts",
    "bench:terminal:analyze": "node scripts/analyze-terminal-bench.mts",
    "bench:terminal:ablation-plan": "node scripts/terminal-bench-ablation-plan.mts",
    "bench:terminal:compare": "node scripts/compare-terminal-bench-profiles.mts",
    "bench:terminal:debug": "node scripts/debug-terminal-bench.mts",
    "bench:terminal:fleet": "node scripts/run-terminal-bench-fleet.mts",
    "bench:terminal:report": "node scripts/report-terminal-bench.mts",
    "bench:terminal:seal": "node scripts/seal-terminal-bench.mts",
    "bench:terminal:steered": "node scripts/run-terminal-bench-steered.mts",
    "bench:terminal:sync-dataset": "node scripts/sync-terminal-bench-dataset.mts",
    "bench:terminal:suite": "node scripts/run-terminal-bench-suite.mts",
    "bench:swe-tasks": "node scripts/fetch-swe-bench-subset.mts",
    "validate:browser-tools": "node scripts/validate-browser-tools.mts",
    "runners:burst": "node scripts/burst-runners.mts",
    "runners:burst:scw": "node scripts/burst-runners.mts scaleway",
    "e2e:remote": "node scripts/remote-e2e.mts",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:demo": "wdio run wdio.demo.conf.ts",
    "test:e2e:ci": "wdio run wdio.ci.conf.ts",
    "test:e2e:agent-eval": "wdio run wdio.eval.conf.ts",
    "test:e2e:markdown": "wdio run wdio.conf.ts --spec tests/e2e/markdown-ordered-list-spacing.e2e.ts --spec tests/e2e/markdown-streaming-table.e2e.ts --spec tests/e2e/markdown-streaming-list.e2e.ts --spec tests/e2e/markdown-streaming-heading.e2e.ts --spec tests/e2e/markdown-streaming-blockquote.e2e.ts --spec tests/e2e/markdown-nbsp-metadata.e2e.ts",
    "analyze:thread": "node scripts/run-analyze-thread.mts",
    "bench:semantic": "node scripts/semantic-search-bench.mts",
    "sync:models": "node scripts/sync-model-catalog.mts",
    "sync:local-models": "node scripts/sync-local-models.mts",
    "sync:intellect": "node scripts/sync-intellect.mts",
    "sync:cursor-skills": "node scripts/fetch-bundled-cursor-skills.mts",
    "prepare:gortex:mac": "node scripts/prepare-macos-gortex.mts",
    "pack:mac": "npm run build:release && npm run icons:mac && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "dist:mac": "npm run prepare:gortex:mac && npm run build:release && electron-builder --mac -c.publish.channel=$(node scripts/release-channel.mts --channel) --publish never && node scripts/finalize-release-metadata.mts",
    "release:dry": "set -a; [ -f .env ] && . ./.env; set +a; npm run prepare:gortex:mac && npm run build:release && electron-builder --mac -c.mac.notarize=true -c.publish.channel=$(node scripts/release-channel.mts --channel) --publish never && node scripts/finalize-release-metadata.mts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:dead-code && npm run check:oracle && npm test"
  },
  "build": {
    "appId": "app.copse-panel",
    "productName": "Copse",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**/*",
      "**/node_modules/@anthropic-ai/sandbox-runtime/**/*",
      "dist/resources/gortex/**"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "github",
        "owner": "copse-dev",
        "repo": "agent-pane"
      }
    ],
    "mac": {
      "icon": "assets/icons/app.icns",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "26.0",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "brace-expansion@5": "5.0.7",
    "dompurify": "$dompurify",
    "js-yaml@4": "4.3.0",
    "serialize-javascript": "^7.0.7",
    "tar": "^7.5.19",
    "sharp": "0.35.3",
    "fast-xml-parser": "5.10.1"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "@anthropic-ai/sandbox-runtime": "^0.0.65",
    "@anthropic-ai/sdk": "^0.111.0",
    "@copse/streaming-markdown": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@mozilla/readability": "^0.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ddg-search": "^2026.2.16",
    "dompurify": "^3.4.12",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "mermaid": "^11.16.0",
    "micromatch": "^4.0.8",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "openai": "^6.46.0",
    "shell-quote": "^1.10.0",
    "tldts": "^7.4.8",
    "turndown": "^7.2.0",
    "vscode-material-icons": "^0.1.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@nationaldesignstudio/rampart": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^28.0.3",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "@types/shell-quote": "^1.7.5",
    "@types/turndown": "^5.0.5",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "c8": "^11.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-chromedriver": "^43.1.0",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.5",
    "expect-webdriverio": "^5.7.0",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.10.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.5",
    "tar": "^7.5.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "webdriverio": "^9.29.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
